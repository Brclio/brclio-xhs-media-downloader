{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brclio-xhs-downloader",
  "account_id": "c8b059429c868f6d0e528f9e10325f46",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist-web",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/admin*", "/__internal/*", "/assets/membership/alipay.png", "/assets/membership/wechat-pay.png", "/payment-return", "/payment-return.html"]
  },
  "services": [
    { "binding": "PYTHON_API", "service": "brclio-xhs-python" },
    { "binding": "SUBSCRIPTION_PROXY", "service": "brclio-xhs-subscription-proxy" }
  ],
  "browser": { "binding": "BROWSER" },
  "triggers": { "crons": ["17 * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT_RUNTIME", "class_name": "AccountRuntime" },
      { "name": "PARSE_RUNTIME", "class_name": "ParseRuntime" }
    ]
  },
  "migrations": [
    { "tag": "account-runtime-v1", "new_sqlite_classes": ["AccountRuntime"] },
    { "tag": "parse-runtime-v1", "new_sqlite_classes": ["ParseRuntime"] }
  ],
  "version_metadata": { "binding": "DEPLOYMENT" },
  "observability": { "enabled": true },
  "build": { "command": "npm run build:web" }
}
