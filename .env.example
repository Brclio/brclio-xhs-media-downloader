# Server-only values: configure as Cloudflare Worker Secrets (same names on Vercel),
# or copy to .env for the standalone server. Never commit .env.
# Never put real credentials in this file, public assets or desktop packages.
# Standalone only: defaults to sqlite. Vercel/Cloudflare always retain GitHub storage.
# Set github to run the standalone server against the existing private repository.
# AUTH_STORAGE_DRIVER=sqlite
# AUTH_SQLITE_PATH=./data/accounts.sqlite
# HOST=127.0.0.1
# PORT=3000
# PYTHON_BIN=python3
# Explicit trusted proxy IPs/CIDRs only; empty ignores forwarding headers.
# SERVER_TRUST_PROXY=127.0.0.1,::1
# SERVER_MEDIA_TIMEOUT_MS=25000
# SERVER_REQUEST_TIMEOUT_MS=60000
# SERVER_NODE_CONCURRENCY=4
# SERVER_PYTHON_CONCURRENCY=2
# SERVER_MAX_REQUESTS=32
AUTH_SITE_ORIGIN=https://your-downloader.example.com
# Optional Brclio Pay, server Secrets only. Existing manual payment stays usable
# while these are absent. Local secret file is ignored; never package it.
BRCLIO_PAY_BASE_URL=https://pay.bornforthis.cn
BRCLIO_PAY_CLIENT_ID=xhs-downloader
BRCLIO_PAY_API_SECRET=
BRCLIO_PAY_WEBHOOK_SECRET=
BRCLIO_PAY_MODE=live
# Separate WeChat center; keep the existing Alipay credentials above.
BRCLIO_WECHAT_PAY_BASE_URL=https://paywc.bornforthis.cn
BRCLIO_WECHAT_PAY_CLIENT_ID=p-2bb6d77a673327a2f8d881bac2d4fe26
BRCLIO_WECHAT_PAY_API_KEY=
BRCLIO_WECHAT_PAY_WEBHOOK_SECRET=
# Optional Google login. Create a Google Auth Platform "Web application" OAuth
# client and keep BOTH values in backend Secrets, never in the desktop package.
# The exact authorized redirect URI is AUTH_SITE_ORIGIN + /?google_callback=1.
# Production: https://xhs.download.brclio.com/?google_callback=1
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Optional override must exactly match the fixed callback above.
# AUTH_GOOGLE_REDIRECT_URI=https://your-downloader.example.com/?google_callback=1
AUTH_GITHUB_OWNER=your-github-owner
AUTH_GITHUB_REPO=xhs-account-data
AUTH_GITHUB_BRANCH=main
AUTH_GITHUB_PATH=state/accounts.json
AUTH_GITHUB_TOKEN=
AUTH_SECRET_PEPPER=
# Optional signed desktop entitlements. Keep the Ed25519 PRIVATE PEM only in
# server Secrets; package the matching PUBLIC key in desktop/account-config.json.
# Generate with node scripts/provision-entitlement-key.mjs (does not deploy).
# AUTH_ENTITLEMENT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# AUTH_ENTITLEMENT_KEY_ID=v1
# Optional bootstrap only. Store the real value as a Cloudflare Secret.
# Later changes use the encrypted admin configuration; never put credentials here.
WEB_PARSE_PROXY_SUBSCRIPTION_URL=
AUTH_ADMIN_EMAILS=admin@example.com
AUTH_DEVICE_LIMIT=1
# GitHub only: enable to create the first state file, disable after initialization.
# SQLite automatically creates its database and does not use this flag.
AUTH_ALLOW_INITIALIZE=false
AUTH_MAIL_PROVIDER=resend
AUTH_MAIL_FROM=Brclio <accounts@example.com>
AUTH_MAIL_API_KEY=
AUTH_MAIL_WEBHOOK_URL=
AUTH_MAIL_WEBHOOK_SECRET=
AUTH_SMTP_HOST=smtp.gmail.com
AUTH_SMTP_PORT=465
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_EMAIL_HOURLY_LIMIT=6
AUTH_IP_HOURLY_LIMIT=20
AUTH_GLOBAL_HOURLY_LIMIT=200
