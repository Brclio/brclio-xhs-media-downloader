{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/parse.js": {
      "maxDuration": 20
    },
    "api/image.js": {
      "maxDuration": 20
    },
    "api/python_parse.py": {
      "maxDuration": 20,
      "excludeFiles": "{test/**,README.md,*.zip}"
    },
    "api/python_image.py": {
      "maxDuration": 20,
      "excludeFiles": "{test/**,README.md,*.zip}"
    },
    "api/video.js": {
      "maxDuration": 20
    },
    "api/python_video.py": {
      "maxDuration": 20,
      "excludeFiles": "{test/**,README.md,*.zip}"
    },
    "api/account.js": {
      "maxDuration": 60,
      "excludeFiles": "{desktop/**,desktop-runtime/**,dist-desktop/**,test/**,docs/**}"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "buildCommand": "node deploy/build-web.mjs",
  "outputDirectory": "dist-web",
  "installCommand": "npm ci --omit=dev --ignore-scripts"
}
